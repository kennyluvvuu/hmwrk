# hmwrk configuration. Copy to deploy/.env (compose) or repo-root .env
# (local `npm start` with tsx) and fill in real values.
# Variable names are defined by src/config/env.ts; never commit real secrets.

# --- HTTP ---------------------------------------------------------------

# Port the core listens on inside the container. Compose publishes it only on
# the internal network (http://hmwrk:8787/v1), not to the host.
PORT=8787

# Where SQLite and photos live. Compose overrides this with /data (the
# hmwrk-data volume); ./data is the default for local runs.
DATA_DIR=./data

# debug | info | warn | error
LOG_LEVEL=info

# --- LLM providers (SPEC §7) -------------------------------------------

# Groq: read slot (vision — screenshots, notebook photos).
# Key: https://console.groq.com/keys
GROQ_API_KEY=

# Mistral: verify + chat slots (DeepSeek text models).
# Key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Telegram (outbound sendMessage only) ------------------------------

# Bot token from @BotFather. Leave empty to disable reminders/digest.
TELEGRAM_BOT_TOKEN=

# --- Role fallback keys (ADR 0004, SPEC §4) ----------------------------

# Two static API keys the core accepts instead of OpenWebUI user headers:
# one per role. Required (the container refuses to boot without them).
# Generate with: openssl rand -hex 32
# Use them as the "API key" of the OpenAI connection in OpenWebUI.
HMWRK_PARENT_KEY=replace-with-long-random-string-parent
HMWRK_CHILD_KEY=replace-with-long-random-string-child

# --- Optional -----------------------------------------------------------

# Absolute path to models.json outside DATA_DIR. Leave empty to use the
# default <DATA_DIR>/models.json (in the container: /data/models.json).
# See models.example.json in the repo root for the format.
MODELS_CONFIG=

# Timezone for reminders/digests and date formatting (container TZ).
# Read by Node, not by src/config/env.ts (which ignores unknown variables).
# Compose defaults it to Europe/Moscow when unset.
TZ=Europe/Moscow
